{
  "manifest_version": 3,
  "name": "Drift — Daily Digest",
  "version": "0.9.0",
  "description": "Two or three fresh headlines per topic you follow, one click away. No feed to scroll, no inbox to clear, no tab to keep open.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Drift — your digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/sources/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://arstechnica.com/*",
    "https://decrypt.co/*",
    "https://dev.to/*",
    "https://electrek.co/*",
    "https://feed.infoq.com/*",
    "https://feeds.bbci.co.uk/*",
    "https://feeds.feedburner.com/*",
    "https://feeds.npr.org/*",
    "https://github.blog/*",
    "https://grist.org/*",
    "https://insideclimatenews.org/*",
    "https://insideevs.com/*",
    "https://jalopnik.com/*",
    "https://kotaku.com/*",
    "https://krebsonsecurity.com/*",
    "https://lithub.com/*",
    "https://news.crunchbase.com/*",
    "https://news.ycombinator.com/*",
    "https://petapixel.com/*",
    "https://pitchfork.com/*",
    "https://rss.politico.com/*",
    "https://search.cnbc.com/*",
    "https://sifted.eu/*",
    "https://spacenews.com/*",
    "https://sports.yahoo.com/*",
    "https://techcrunch.com/*",
    "https://the-decoder.com/*",
    "https://uxdesign.cc/*",
    "https://variety.com/*",
    "https://www.aljazeera.com/*",
    "https://www.archdaily.com/*",
    "https://www.billboard.com/*",
    "https://www.bleepingcomputer.com/*",
    "https://www.bonappetit.com/*",
    "https://www.carbonbrief.org/*",
    "https://www.cbssports.com/*",
    "https://www.coindesk.com/*",
    "https://www.dezeen.com/*",
    "https://www.dpreview.com/*",
    "https://www.eater.com/*",
    "https://www.espn.com/*",
    "https://www.eurogamer.net/*",
    "https://www.indiewire.com/*",
    "https://www.kiplinger.com/*",
    "https://www.marketwatch.com/*",
    "https://www.marktechpost.com/*",
    "https://www.nasa.gov/*",
    "https://www.nerdwallet.com/*",
    "https://www.newscientist.com/*",
    "https://www.nngroup.com/*",
    "https://www.outsideonline.com/*",
    "https://www.pcgamer.com/*",
    "https://www.polygon.com/*",
    "https://www.quantamagazine.org/*",
    "https://www.runnersworld.com/*",
    "https://www.sciencedaily.com/*",
    "https://www.sciencenews.org/*",
    "https://www.smashingmagazine.com/*",
    "https://www.statnews.com/*",
    "https://www.stereogum.com/*",
    "https://www.technologyreview.com/*",
    "https://www.theguardian.com/*",
    "https://www.universetoday.com/*",
    "<all_urls>"
  ]
}
