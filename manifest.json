{
  "manifest_version": 3,
  "name": "Drift — Floating Digest",
  "version": "0.5.0",
  "description": "A small bubble that floats over any page. Click it for 2-3 fresh headlines per topic you follow. Drag it anywhere, or hide it.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Drift — your digest"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/data.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://www.technologyreview.com/*",
    "https://arstechnica.com/*",
    "https://grist.org/*",
    "https://www.carbonbrief.org/*",
    "https://spacenews.com/*",
    "https://www.space.com/*",
    "https://techcrunch.com/*",
    "https://news.crunchbase.com/*",
    "https://www.statnews.com/*",
    "https://www.medicalnewstoday.com/*",
    "https://www.polygon.com/*",
    "https://kotaku.com/*",
    "https://www.smashingmagazine.com/*",
    "https://uxdesign.cc/*",
    "https://www.marketwatch.com/*",
    "https://www.investopedia.com/*",
    "https://www.quantamagazine.org/*",
    "https://phys.org/*",
    "https://www.espn.com/*",
    "https://www.cbssports.com/*"
  ]
}
